.tools
.trae-html-share-packages

# 依赖与构建产物（镜像内重新构建）
**/node_modules
**/dist
**/target
**/.venv
**/__pycache__
**/*.pyc
**/*.log
**/*.bak
**/*.prev

# 运行数据与日志
logs/
output/
tmp/
data/
evidence/

# 与镜像构建无关的目录
agent-service/
agent-design-optimization/
agent-test-framework/
resume-highlights/
vibepaper-architecture-review/
